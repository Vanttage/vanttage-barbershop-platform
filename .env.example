# ─────────────────────────────────────────────────────────────────────────────
#  VANTTAGE — variables de entorno
#  Copia este archivo a `.env` y completa los valores reales.
#  `.env` está en .gitignore — nunca lo commitees.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Supabase Postgres) ──────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: pooler de "Transaction mode" (puerto 6543) — la usan Next.js
#   y Prisma Client en runtime. Requiere `?pgbouncer=true` para que Prisma
#   no use prepared statements (incompatibles con el pooler).
# DIRECT_URL: conexión directa (puerto 5432) — la usa Prisma CLI solo para
#   `migrate`/`db push`, que necesitan sesión persistente.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ── Auth (NextAuth) ─────────────────────────────────────────────────────────
# Genera un valor con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# ── Login con Google — opcional, sin esto el botón de Google no aparece ────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://tudominio.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Multi-tenant / dominios ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_DOMAIN="vanttage.app"
# Slug de tenant a usar en localhost cuando no hay subdominio (dev only).
# Debe existir en la DB — coincide con SEED_TENANT_SLUG si corres `npm run db:seed`.
VANTTAGE_DEV_TENANT="mi-barberia"

# ── Cron / endpoints internos ───────────────────────────────────────────────
# Protege /api/cron/* y /api/test/*. Genera igual que NEXTAUTH_SECRET.
CRON_SECRET=

# ── Email (Resend) — opcional, sin esto no se envían emails ────────────────
RESEND_API_KEY=
RESEND_FROM="NAVA <noreply@vanttagetech.com>"

# ── Telegram — opcional, sin esto no aparece el botón de Telegram ─────────
# Token que da @BotFather al crear el bot con /newbot.
TELEGRAM_BOT_TOKEN=
# String aleatorio propio (no lo da Telegram) — valida que los webhooks
# entrantes en /api/telegram/webhook realmente vengan de Telegram.
# Genera uno igual que NEXTAUTH_SECRET.
TELEGRAM_WEBHOOK_SECRET=
# Username del bot SIN @ (ej: NavaRecordatoriosBot) — solo se lee en el
# servidor (POST /api/public/telegram-link) para armar el link
# https://t.me/<username>?start=<token>.
TELEGRAM_BOT_USERNAME=
# Después de configurar lo anterior en producción, corre:
#   npm run telegram:setup

# ── Rate limiting (Upstash Redis) — opcional ────────────────────────────────
# Sin esto, el rate limiting cae a un fallback en memoria (solo válido en dev,
# no sirve en serverless con múltiples instancias).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry — opcional ────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Seed / bootstrap (solo usados por `npm run db:seed` y `db:superadmin`) ──
SUPERADMIN_EMAIL="superadmin@vanttage.app"
SUPERADMIN_PASSWORD="cambia-esta-clave"
SEED_TENANT_NAME="Mi Barbería"
SEED_TENANT_SLUG="mi-barberia"
SEED_OWNER_EMAIL="owner@mi-barberia.co"
SEED_OWNER_PASSWORD="cambia-esta-clave"
